# ==============================================================================
# VISUALIFY GENERATION WORKER - PHASE 0 ENVIRONMENT TEMPLATE
# ==============================================================================
# CLASSIFICATION: WORKER SERVER-SIDE ONLY
# Copy to backend/worker/.env.local for local Phase 0 spike execution.
# Never expose these variables to the frontend or commit .env.local to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# GEMINI API CONFIGURATION (PRIVATE SECRET + SERVER CONFIG)
# ------------------------------------------------------------------------------
# Server-only Google Gemini API key (required for `npm run spike:gemini`)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Pinned Gemini model identifier (NON-SECRET server config)
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# EXCALIDRAW CLI & HEADLESS BROWSER CONFIGURATION (LOCAL WORKER RUNTIME)
# ------------------------------------------------------------------------------
# Absolute path to Chrome, Chromium, or Edge executable for @excalidraw/cli.
# Leave unset or set to match your local OS:
# - Windows:       C:\Program Files\Google\Chrome\Application\chrome.exe
# - Linux / WSL:   /usr/bin/chromium  or  /usr/bin/google-chrome
# - macOS:         /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
EXCALIDRAW_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Bounded CLI rendering timeout in milliseconds (1000..120000; default 30000)
CLI_RENDER_TIMEOUT_MS=30000
