{
  "name": "@visualify/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls:sql": "node --test ../supabase/tests/rls.pglite.test.js ../supabase/tests/notes.pglite.test.js ../supabase/tests/sources.pglite.test.js ../supabase/tests/learning_companion.pglite.test.js ../supabase/tests/phase6_hardening.pglite.test.js",
    "test:rls:live": "node --test ../supabase/tests/rls.live.test.js",
    "test:load": "node scripts/loadTest.js",
    "smoke:generation": "node scripts/smokeGeneration.js",
    "smoke:live-api": "node scripts/liveApiSmoke.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "autocannon": "9.0.0",
    "supertest": "7.3.2",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@sentry/node": "11.18.0",
    "@supabase/supabase-js": "2.119.0",
    "@visualify/worker": "0.1.0",
    "bullmq": "6.7.10",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "file-type": "22.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.1.0",
    "multer": "2.5.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "rate-limit-redis": "6.0.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
