# ==============================================================================
# VISUALIFY EXPRESS API - ENVIRONMENT TEMPLATE (Phase 1)
# ==============================================================================
# CLASSIFICATION: SERVER-SIDE ONLY
# Copy to backend/.env.local (gitignored). Never commit real values and never
# expose these variables to the frontend (no VITE_ prefix).
# ==============================================================================

# development | test | staging | production
NODE_ENV=development

# Port the API listens on
PORT=5000

# Exact allowed CORS origin(s). Comma-separate multiple origins. Never "*".
FRONTEND_ORIGIN=http://localhost:5173

# Supabase project URL and publishable key (used for token verification and
# user-scoped, RLS-enforced database/storage access)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# PRIVATE SECRET - bypasses RLS. Required for generation (Phase 2): used ONLY
# by the in-process generation job runner to write pipeline results, always
# filtered by job id / verified owner. All user-facing reads stay RLS-scoped.
# Never log it, never send it to the browser, never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ------------------------------------------------------------------------------
# GENERATION (Phase 2)
# ------------------------------------------------------------------------------
# The generation worker runs in-process. GEMINI_API_KEY, GEMINI_MODEL and
# EXCALIDRAW_BROWSER_PATH may live here OR in backend/worker/.env.local (read
# second, never overriding this file). Generation is disabled (503) unless
# both SUPABASE_SERVICE_ROLE_KEY and GEMINI_API_KEY are set.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional comma-separated fallback models (max 3; defaults to gemini-3.1-flash-lite / gemini-3.5-flash-lite)
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Max jobs running at once in this process (each holds one model call)
GENERATION_MAX_CONCURRENCY=2
# Global cap on simultaneous @excalidraw/cli / Chromium processes (1..8, default 2)
RENDER_CONCURRENCY=2
# Per model-call timeout and hard limit for a whole job (milliseconds)
GENERATION_PLANNER_TIMEOUT_MS=90000
GENERATION_JOB_TIMEOUT_MS=240000
# Chrome/Chromium/Edge for Mermaid conversion (auto-detected when unset)
# EXCALIDRAW_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CLI_RENDER_TIMEOUT_MS=30000

# Avatar upload limit in bytes (2 MiB) and signed URL lifetime in seconds
AVATAR_MAX_BYTES=2097152
AVATAR_SIGNED_URL_TTL_SECONDS=300

# Phase 4 source file limits (20 MiB upload, 100 PDF pages per generation)
SOURCE_MAX_BYTES=20971520
SOURCE_MAX_PDF_PAGES=100
SOURCE_SIGNED_URL_TTL_SECONDS=300

# Set to "true" ONLY when running behind a single trusted reverse proxy
# (e.g. Render/Vercel) so rate limiting uses the real client IP.
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# PHASE 6 LAUNCH HARDENING: QUOTAS, REDIS QUEUE, SENTRY & ADMIN
# ------------------------------------------------------------------------------
# Monthly billable AI operations quota per user (enforced server-side before model calls)
GENERATION_LIMIT_MONTHLY=50

# Optional: Redis connection URL for BullMQ generation queue and distributed rate limiting
# REDIS_URL=redis://localhost:6379

# Optional: Sentry DSN for server error tracking (PII scrubbed before send)
# SENTRY_DSN=

# Optional: comma-separated Supabase user UUIDs allowed to inspect redacted job metadata
# ADMIN_USER_IDS=
