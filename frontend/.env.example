# ==============================================================================
# VISUALIFY FRONTEND - ENVIRONMENT TEMPLATE (Phase 1)
# ==============================================================================
# CLASSIFICATION: PUBLIC (Client-Bundled)
# Every VITE_* variable is embedded into the browser bundle and visible to users.
# NEVER put SUPABASE_SERVICE_ROLE_KEY, GEMINI_API_KEY or any other secret here.
#
# Copy to frontend/.env.local (gitignored) and fill in real values.
# ==============================================================================

# Supabase project URL (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase publishable (anon) key - safe for the browser ONLY because RLS is enforced
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Express API origin (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000
