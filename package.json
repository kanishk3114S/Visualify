{
  "name": "visualify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Visualify monorepo: React frontend, Express API and generation worker",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "frontend",
    "backend",
    "backend/worker"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:api": "npm --workspace=@visualify/api run dev",
    "build:frontend": "npm --workspace=frontend run build",
    "lint": "node scripts/lint.js",
    "test": "npm --workspace=backend/worker run test && npm --workspace=@visualify/api run test && npm --workspace=@visualify/api run test:rls:sql && npm --workspace=@visualify/frontend run test",
    "test:worker": "npm --workspace=backend/worker run test",
    "test:api": "npm --workspace=@visualify/api run test",
    "test:rls:sql": "npm --workspace=@visualify/api run test:rls:sql",
    "test:rls:live": "npm --workspace=@visualify/api run test:rls:live",
    "test:load": "npm --workspace=@visualify/api run test:load",
    "test:e2e": "playwright test",
    "spike:local": "npm --workspace=backend/worker run spike:local",
    "spike:gemini": "npm --workspace=backend/worker run spike:gemini",
    "test:frontend": "npm --workspace=@visualify/frontend run test",
    "smoke:generation": "npm --workspace=@visualify/api run smoke:generation",
    "smoke:live-api": "npm --workspace=@visualify/api run smoke:live-api"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1"
  },
  "overrides": {
    "axe-core": "4.14.0"
  }
}
