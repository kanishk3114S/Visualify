{
  "name": "visualify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Visualify Phase 0 technical spike workspace",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "frontend",
    "backend/worker"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace=frontend run dev",
    "build:frontend": "npm --workspace=frontend run build",
    "test": "npm --workspace=backend/worker run test",
    "test:e2e": "playwright test",
    "spike:local": "npm --workspace=backend/worker run spike:local",
    "spike:gemini": "npm --workspace=backend/worker run spike:gemini"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
